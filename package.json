{
  "name": "impot-3ce",
  "version": "1.0.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "icon": "node scripts/build-icon.js",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --minify",
    "watch": "tailwindcss -i ./assets/css/input.css -o ./assets/css/style.css --watch"
  },
  "build": {
    "appId": "com.cabinet.impot3ce",
    "productName": "3CE FISCUS - Système de Gestion Fiscale",
    "directories": {
      "output": "dist_desktop"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "impot-3ce-setup-${version}.${ext}",
      "icon": "assets/img/icon.png",
      "publish": [
        {
          "provider": "github",
          "owner": "MOHDEV520",
          "repo": "impot-3ce"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "3CE FISCUS"
    },
    "asar": false,
    "files": [
      "**/*",
      "!dist_desktop/**/*",
      "!dist/**/*",
      "!backups/**/*",
      "!.vscode/**/*",
      "!.git/**/*",
      "!.gitignore",
      "!**/*.sqlite",
      "!**/*.sqlite-journal",
      "!**/*.sqlite-wal",
      "!**/*.sqlite-shm",
      "!**/*.log",
      "!test_sql.php",
      "!test_css.php",
      "!install.php",
      "!_tmp_*",
      "!nul",
      "!assets/css/input.css",
      "!tailwind.config.js",
      "!postcss.config.js",
      "!assets/vendor/fontawesome/svgs/**/*",
      "!assets/vendor/fontawesome/svgs-full/**/*",
      "!assets/vendor/fontawesome/sprites/**/*",
      "!assets/vendor/fontawesome/sprites-full/**/*",
      "!assets/vendor/fontawesome/scss/**/*",
      "!assets/vendor/fontawesome/metadata/**/*",
      "!assets/vendor/fontawesome/js/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "electron-updater": "^6.8.3"
  }
}
